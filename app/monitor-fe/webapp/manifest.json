{
	"_version": "2.0.0",
	"sap.app": {
		"id": "hydac.custmon",
		"type": "application",
		"i18n": {
			"bundleName": "hydac.custmon.i18n.i18n",
			"supportedLocales": ["", "de"],
			"fallbackLocale": ""
		},
		"title": "{{appTitle}}",
		"description": "{{appDescription}}",
		"applicationVersion": {
			"version": "0.2.0"
		},
		"dataSources": {
			"mainService": {
				"uri": "/odata/v4/monitor/",
				"type": "OData",
				"settings": {
					"odataVersion": "4.0"
				}
			}
		}
	},
	"sap.ui": {
		"technology": "UI5",
		"deviceTypes": {
			"desktop": true,
			"tablet": true,
			"phone": false
		}
	},
	"sap.ui5": {
		"flexEnabled": true,
		"rootView": {
			"viewName": "sap.fe.templates.RootContainer.view.Fcl",
			"type": "XML",
			"id": "appRootView"
		},
		"dependencies": {
			"minUI5Version": "1.148.12",
			"libs": {
				"sap.ui.core": {},
				"sap.m": {},
				"sap.f": {},
				"sap.fe.templates": {}
			}
		},
		"contentDensities": {
			"compact": true,
			"cozy": true
		},
		"models": {
			"i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"settings": {
					"bundleName": "hydac.custmon.i18n.i18n",
					"supportedLocales": ["", "de"],
					"fallbackLocale": ""
				}
			},
			"": {
				"dataSource": "mainService",
				"preload": true,
				"settings": {
					"operationMode": "Server",
					"autoExpandSelect": true,
					"earlyRequests": true
				}
			}
		},
		"resources": {
			"css": [
				{
					"uri": "css/style.css"
				}
			]
		},
		"routing": {
			"config": {
				"routerClass": "sap.f.routing.Router",
				"controlId": "appContent",
				"controlAggregation": "beginColumnPages",
				"flexibleColumnLayout": {
					"defaultTwoColumnLayoutType": "TwoColumnsMidExpanded"
				}
			},
			"routes": [
				{
					"name": "RequestsList",
					"pattern": ":?query:",
					"target": ["RequestsList"]
				},
				{
					"name": "RequestsObjectPage",
					"pattern": "Requests({key}):?query:",
					"target": ["RequestsList", "RequestsObjectPage"]
				}
			],
			"targets": {
				"RequestsList": {
					"type": "Component",
					"id": "RequestsList",
					"name": "sap.fe.templates.ListReport",
					"controlAggregation": "beginColumnPages",
					"options": {
						"settings": {
							"contextPath": "/Requests",
							"defaultTemplateAnnotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#Default",
							"initialLoad": "Enabled",
							"variantManagement": "None",
							"navigation": {
								"Requests": {
									"detail": {
										"route": "RequestsObjectPage"
									}
								}
							},
							"controlConfiguration": {
								"@com.sap.vocabularies.UI.v1.LineItem": {
									"tableSettings": {
										"type": "ResponsiveTable",
										"selectionMode": "None",
										"personalization": {
											"column": true,
											"sort": true,
											"filter": false,
											"group": false
										},
										"popinLayout": "GridSmall"
									},
									"columns": {
										"HintsColumn": {
											"key": "HintsColumn",
											"header": "{i18n>list.col.hints}",
											"template": "hydac.custmon.ext.fragment.HintsColumn",
											"availability": "Default",
											"importance": "High",
											"width": "5.5rem",
											"horizontalAlign": "Begin",
											"properties": ["released", "inClarification", "orderExists"],
											"position": {
												"placement": "After",
												"anchor": "DataField::status_code"
											}
										}
									}
								}
							}
						}
					}
				},
				"RequestsObjectPage": {
					"type": "Component",
					"id": "RequestsObjectPage",
					"name": "sap.fe.templates.ObjectPage",
					"controlAggregation": "midColumnPages",
					"options": {
						"settings": {
							"contextPath": "/Requests",
							"editableHeaderContent": false,
							"showRelatedApps": false
						}
					}
				}
			}
		}
	},
	"sap.fiori": {
		"registrationIds": [],
		"archeType": "transactional"
	}
}

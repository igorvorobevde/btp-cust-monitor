<mvc:View
	controllerName="hydac.custmon.controller.List"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:f="sap.f"
	xmlns:l="sap.ui.layout"
	xmlns="sap.m">
	<f:DynamicPage
		id="listPage"
		headerExpanded="true"
		toggleHeaderOnTitleClick="true">
		<f:title>
			<f:DynamicPageTitle>
				<f:heading>
					<Title text="{i18n>list.title}" level="H1"/>
				</f:heading>
			</f:DynamicPageTitle>
		</f:title>
		<f:header>
			<f:DynamicPageHeader pinnable="true">
				<VBox>
					<l:Grid id="filterGrid" defaultSpan="XL3 L3 M6 S12" vSpacing="0.5" hSpacing="1">
						<VBox>
							<Label text="{i18n>list.filter.search}" labelFor="filterSearch"/>
							<SearchField
								id="filterSearch"
								value="{view>/filter/search}"
								placeholder="{i18n>list.filter.search.placeholder}"
								search=".onSearch"/>
						</VBox>
						<VBox>
							<Label text="{i18n>list.filter.customer}" labelFor="filterCustomer"/>
							<Input id="filterCustomer" value="{view>/filter/customer}" maxLength="10" submit=".onSearch"/>
						</VBox>
						<VBox>
							<Label text="{i18n>list.filter.salesOrg}" labelFor="filterSalesOrg"/>
							<MultiComboBox
								id="filterSalesOrg"
								selectedKeys="{view>/filter/salesOrganizations}"
								items="{path: 'view>/salesOrganizations', templateShareable: false}">
								<core:Item key="{view>key}" text="{view>key}"/>
							</MultiComboBox>
						</VBox>
						<VBox>
							<Label text="{i18n>list.filter.processType}" labelFor="filterProcessType"/>
							<MultiComboBox
								id="filterProcessType"
								selectedKeys="{view>/filter/processTypes}"
								items="{path: '/ProcessTypes', sorter: {path: 'code'}, templateShareable: false}">
								<core:Item key="{code}" text="{text}"/>
							</MultiComboBox>
						</VBox>
						<VBox>
							<Label text="{i18n>list.filter.status}" labelFor="filterStatus"/>
							<MultiComboBox
								id="filterStatus"
								selectedKeys="{view>/filter/statuses}"
								placeholder="{i18n>list.filter.status.placeholder}"
								items="{path: '/Statuses', sorter: {path: 'code'}, templateShareable: false}">
								<core:Item key="{code}" text="{code} – {text}"/>
							</MultiComboBox>
						</VBox>
						<VBox>
							<Label text="{i18n>list.filter.source}" labelFor="filterSource"/>
							<MultiComboBox
								id="filterSource"
								selectedKeys="{view>/filter/sources}"
								items="{path: 'view>/sources', templateShareable: false}">
								<core:Item key="{view>key}" text="{view>key}"/>
							</MultiComboBox>
						</VBox>
						<VBox>
							<Label text="{i18n>list.filter.orderExists}" labelFor="filterOrderExists"/>
							<Select id="filterOrderExists" selectedKey="{view>/filter/orderExists}" width="100%">
								<core:Item key="ALL" text="{i18n>list.filter.orderExists.all}"/>
								<core:Item key="YES" text="{i18n>list.filter.orderExists.yes}"/>
								<core:Item key="NO" text="{i18n>list.filter.orderExists.no}"/>
							</Select>
						</VBox>
						<VBox>
							<Label text="{i18n>list.filter.createdAt}" labelFor="filterCreatedAt"/>
							<DateRangeSelection
								id="filterCreatedAt"
								dateValue="{view>/filter/createdFrom}"
								secondDateValue="{view>/filter/createdTo}"/>
						</VBox>
						<VBox>
							<Label text="{i18n>list.filter.createdBy}" labelFor="filterCreatedBy"/>
							<Input id="filterCreatedBy" value="{view>/filter/createdBy}" submit=".onSearch"/>
						</VBox>
						<VBox>
							<Label text="{i18n>list.filter.modifiedBy}" labelFor="filterModifiedBy"/>
							<Input id="filterModifiedBy" value="{view>/filter/modifiedBy}" submit=".onSearch"/>
						</VBox>
						<VBox>
							<Label text="{i18n>list.filter.modifiedAt}" labelFor="filterModifiedAt"/>
							<DateRangeSelection
								id="filterModifiedAt"
								dateValue="{view>/filter/modifiedFrom}"
								secondDateValue="{view>/filter/modifiedTo}"/>
						</VBox>
						<VBox justifyContent="End">
							<CheckBox id="filterIncludeDone" text="{i18n>list.filter.includeDone}" selected="{view>/filter/includeDone}"/>
							<CheckBox id="filterIncludeRejected" text="{i18n>list.filter.includeRejected}" selected="{view>/filter/includeRejected}"/>
						</VBox>
						<VBox justifyContent="End">
							<CheckBox id="filterOnlyUnreleased" text="{i18n>list.filter.onlyUnreleased}" selected="{view>/filter/onlyUnreleased}"/>
							<CheckBox id="filterOnlyClarification" text="{i18n>list.filter.onlyClarification}" selected="{view>/filter/onlyClarification}"/>
						</VBox>
					</l:Grid>
					<OverflowToolbar style="Clear">
						<ToolbarSpacer/>
						<Button id="filterGo" text="{i18n>list.filter.go}" type="Emphasized" press=".onSearch"/>
						<Button id="filterReset" text="{i18n>list.filter.reset}" press=".onResetFilters"/>
					</OverflowToolbar>
				</VBox>
			</f:DynamicPageHeader>
		</f:header>
		<f:content>
			<Table
				id="requestsTable"
				mode="SingleSelectMaster"
				growing="true"
				growingThreshold="50"
				growingScrollToLoad="true"
				sticky="ColumnHeaders,HeaderToolbar"
				busyIndicatorDelay="0"
				noDataText="{i18n>list.noData}"
				selectionChange=".onSelectionChange"
				updateFinished=".onUpdateFinished"
				items="{
					path: '/Requests',
					parameters: {
						$count: true
					},
					sorter: {path: 'createdAt', descending: false},
					suspended: true
				}">
				<headerToolbar>
					<OverflowToolbar>
						<Title
							id="tableTitle"
							level="H2"
							text="{parts: ['i18n>list.tableTitle', 'view>/count'], formatter: '.formatter.formatMessage'}"/>
						<ToolbarSpacer/>
						<OverflowToolbarButton
							id="refreshButton"
							icon="sap-icon://refresh"
							text="{i18n>common.refresh}"
							tooltip="{i18n>common.refresh}"
							press=".onRefresh"/>
						<OverflowToolbarButton
							id="sortButton"
							icon="sap-icon://sort"
							text="{i18n>list.sort}"
							tooltip="{i18n>list.sort}"
							press=".onOpenSortDialog"/>
					</OverflowToolbar>
				</headerToolbar>
				<columns>
					<Column width="13rem">
						<Text text="{i18n>list.col.status}"/>
					</Column>
					<Column width="5.5rem">
						<Text text="{i18n>list.col.hints}"/>
					</Column>
					<Column minScreenWidth="Desktop" demandPopin="true">
						<Text text="{i18n>list.col.processType}"/>
					</Column>
					<Column width="16rem">
						<Text text="{i18n>list.col.name}"/>
					</Column>
					<Column minScreenWidth="Desktop" demandPopin="true">
						<Text text="{i18n>list.col.customer}"/>
					</Column>
					<Column minScreenWidth="Desktop" demandPopin="true" width="5rem">
						<Text text="{i18n>list.col.salesOrg}"/>
					</Column>
					<Column minScreenWidth="Desktop" demandPopin="true">
						<Text text="{i18n>list.col.magentoCompany}"/>
					</Column>
					<Column minScreenWidth="Desktop" demandPopin="true" hAlign="End">
						<Text text="{i18n>list.col.orderVolume}"/>
					</Column>
					<Column minScreenWidth="Desktop" demandPopin="true">
						<Text text="{i18n>list.col.created}"/>
					</Column>
					<Column minScreenWidth="Desktop" demandPopin="true">
						<Text text="{i18n>list.col.modified}"/>
					</Column>
				</columns>
				<items>
					<ColumnListItem
						type="Navigation"
						highlight="{path: 'orderExists', targetType: 'any', formatter: '.formatter.rowHighlight'}">
						<cells>
							<ObjectStatus
								text="{parts: ['status_code', 'appView>/statuses'], formatter: '.formatter.statusText'}"
								icon="{parts: ['status_code', 'appView>/statuses'], formatter: '.formatStatusIcon'}"
								state="{parts: ['status_code', 'appView>/statuses'], formatter: '.formatStatusState'}"/>
							<HBox>
								<core:Icon
									src="sap-icon://locked"
									class="custmonHintIcon"
									visible="{= !${path: 'released', targetType: 'any'} }"
									tooltip="{i18n>list.hint.notReleased}"
									alt="{i18n>list.hint.notReleased}"/>
								<core:Icon
									src="sap-icon://question-mark"
									class="custmonHintIcon"
									visible="{= !!${path: 'inClarification', targetType: 'any'} }"
									tooltip="{i18n>list.hint.inClarification}"
									alt="{i18n>list.hint.inClarification}"/>
								<core:Icon
									src="sap-icon://cart"
									class="custmonHintIcon"
									visible="{= !!${path: 'orderExists', targetType: 'any'} }"
									tooltip="{i18n>list.hint.orderExists}"
									alt="{i18n>list.hint.orderExists}"/>
							</HBox>
							<Text text="{parts: ['processType', 'appView>/processTypeTexts'], formatter: '.formatter.processTypeText'}"/>
							<ObjectIdentifier title="{name}" text="{name2}"/>
							<Text text="{customer}"/>
							<Text text="{salesOrganization}"/>
							<Text text="{magentoCompany}"/>
							<ObjectNumber number="{orderVolume}" unit="{currency}"/>
							<VBox>
								<Text text="{createdAt}"/>
								<Text text="{createdBy}"/>
							</VBox>
							<VBox>
								<Text text="{modifiedAt}"/>
								<Text text="{modifiedBy}"/>
							</VBox>
						</cells>
					</ColumnListItem>
				</items>
			</Table>
		</f:content>
	</f:DynamicPage>
</mvc:View>

<core:FragmentDefinition
	xmlns:core="sap.ui.core"
	xmlns:f="sap.ui.layout.form"
	xmlns="sap.m">
	<f:Form id="formAdmin" editable="{view>/editMode}">
		<f:layout>
			<f:ColumnLayout columnsM="2" columnsL="3" columnsXL="3"/>
		</f:layout>
		<f:formContainers>
			<f:FormContainer title="{i18n>detail.group.assignment}">
				<f:formElements>
					<f:FormElement label="{i18n>field.contactPersonNumber}">
						<f:fields><Text text="{admin/contactPersonNumber}"/></f:fields>
					</f:FormElement>
					<f:FormElement label="{i18n>field.businessPartner}">
						<f:fields><Text text="{admin/businessPartner}"/></f:fields>
					</f:FormElement>
					<f:FormElement label="{i18n>field.magentoCustomer}">
						<f:fields><Text text="{admin/magentoCustomer}"/></f:fields>
					</f:FormElement>
					<f:FormElement label="{i18n>field.shopRole}">
						<f:fields><Input value="{admin/shopRole}" editable="{view>/editMode}"/></f:fields>
					</f:FormElement>
				</f:formElements>
			</f:FormContainer>
			<f:FormContainer title="{i18n>detail.group.person}">
				<f:formElements>
					<f:FormElement label="{i18n>field.title}">
						<f:fields><Input value="{admin/title}" editable="{view>/editMode}"/></f:fields>
					</f:FormElement>
					<f:FormElement label="{i18n>field.firstName}">
						<f:fields><Input id="adminFirstName" value="{admin/firstName}" editable="{view>/editMode}"/></f:fields>
					</f:FormElement>
					<f:FormElement label="{i18n>field.lastName}">
						<f:fields><Input id="adminLastName" value="{admin/lastName}" editable="{view>/editMode}"/></f:fields>
					</f:FormElement>
					<f:FormElement label="{i18n>field.function}">
						<f:fields><Input value="{admin/function}" editable="{view>/editMode}"/></f:fields>
					</f:FormElement>
					<f:FormElement label="{i18n>field.department}">
						<f:fields><Input value="{admin/department}" editable="{view>/editMode}"/></f:fields>
					</f:FormElement>
				</f:formElements>
			</f:FormContainer>
			<f:FormContainer title="{i18n>detail.group.communication}">
				<f:formElements>
					<f:FormElement label="{i18n>field.language}">
						<f:fields><Input value="{admin/language}" editable="{view>/editMode}"/></f:fields>
					</f:FormElement>
					<f:FormElement label="{i18n>field.telephone}">
						<f:fields><Input value="{admin/telephone}" type="Tel" editable="{view>/editMode}"/></f:fields>
					</f:FormElement>
					<f:FormElement label="{i18n>field.email}">
						<f:fields><Input value="{admin/email}" type="Email" editable="{view>/editMode}"/></f:fields>
					</f:FormElement>
				</f:formElements>
			</f:FormContainer>
		</f:formContainers>
	</f:Form>
</core:FragmentDefinition>

<core:FragmentDefinition
	xmlns:core="sap.ui.core"
	xmlns:f="sap.ui.layout.form"
	xmlns="sap.m">
	<f:Form id="formShipTo" editable="{view>/editMode}">
		<f:layout>
			<f:ColumnLayout columnsM="2" columnsL="3" columnsXL="3"/>
		</f:layout>
		<f:formContainers>
			<f:FormContainer title="{i18n>detail.group.assignment}">
				<f:formElements>
					<f:FormElement label="{i18n>field.shipToCustomer}">
						<f:fields><Text text="{shipTo/shipToCustomer}"/></f:fields>
					</f:FormElement>
					<f:FormElement label="{i18n>field.businessPartner}">
						<f:fields><Text text="{shipTo/businessPartner}"/></f:fields>
					</f:FormElement>
					<f:FormElement label="{i18n>field.magentoAddress}">
						<f:fields><Text text="{shipTo/magentoAddress}"/></f:fields>
					</f:FormElement>
					<f:FormElement label="{i18n>field.addressUsedInOrder}">
						<f:fields><Text text="{= ${path: 'shipTo/addressUsedInOrder', targetType: 'any'} ? ${i18n>common.yes} : ${i18n>common.no} }"/></f:fields>
					</f:FormElement>
				</f:formElements>
			</f:FormContainer>
			<f:FormContainer title="{i18n>detail.group.name}">
				<f:formElements>
					<f:FormElement label="{i18n>field.name}">
						<f:fields><Input id="shipToName" value="{shipTo/name}" editable="{view>/editMode}"/></f:fields>
					</f:FormElement>
					<f:FormElement label="{i18n>field.name2}">
						<f:fields><Input value="{shipTo/name2}" editable="{view>/editMode}"/></f:fields>
					</f:FormElement>
					<f:FormElement label="{i18n>field.name3}">
						<f:fields><Input value="{shipTo/name3}" editable="{view>/editMode}"/></f:fields>
					</f:FormElement>
					<f:FormElement label="{i18n>field.name4}">
						<f:fields><Input value="{shipTo/name4}" editable="{view>/editMode}"/></f:fields>
					</f:FormElement>
					<f:FormElement label="{i18n>field.vatNumber}">
						<f:fields><Input value="{shipTo/vatNumber}" editable="{view>/editMode}"/></f:fields>
					</f:FormElement>
				</f:formElements>
			</f:FormContainer>
			<f:FormContainer title="{i18n>detail.group.address}">
				<f:formElements>
					<f:FormElement label="{i18n>field.streetHouseNumber}">
						<f:fields>
							<Input value="{shipTo/street}" editable="{view>/editMode}">
								<layoutData><f:ColumnElementData cellsLarge="8"/></layoutData>
							</Input>
							<Input value="{shipTo/houseNumber}" editable="{view>/editMode}"/>
						</f:fields>
					</f:FormElement>
					<f:FormElement label="{i18n>field.street4}">
						<f:fields><Input value="{shipTo/street4}" editable="{view>/editMode}"/></f:fields>
					</f:FormElement>
					<f:FormElement label="{i18n>field.street5}">
						<f:fields><Input value="{shipTo/street5}" editable="{view>/editMode}"/></f:fields>
					</f:FormElement>
					<f:FormElement label="{i18n>field.postalCodeCity}">
						<f:fields>
							<Input value="{shipTo/postalCode}" editable="{view>/editMode}">
								<layoutData><f:ColumnElementData cellsLarge="3"/></layoutData>
							</Input>
							<Input value="{shipTo/city}" editable="{view>/editMode}"/>
						</f:fields>
					</f:FormElement>
					<f:FormElement label="{i18n>field.country}">
						<f:fields><Input value="{shipTo/country}" editable="{view>/editMode}"/></f:fields>
					</f:FormElement>
				</f:formElements>
			</f:FormContainer>
		</f:formContainers>
	</f:Form>
</core:FragmentDefinition>

<core:FragmentDefinition
	xmlns:core="sap.ui.core"
	xmlns="sap.m">
	<ViewSettingsDialog
		id="sortDialog"
		title="{i18n>list.sort}"
		sortDescending="false"
		confirm=".onSortConfirm">
		<sortItems>
			<ViewSettingsItem key="createdAt" text="{i18n>list.col.createdAt}" selected="true"/>
			<ViewSettingsItem key="modifiedAt" text="{i18n>list.col.modifiedAt}"/>
			<ViewSettingsItem key="status_code" text="{i18n>list.col.status}"/>
			<ViewSettingsItem key="processType" text="{i18n>list.col.processType}"/>
			<ViewSettingsItem key="name" text="{i18n>list.col.name}"/>
			<ViewSettingsItem key="customer" text="{i18n>list.col.customer}"/>
			<ViewSettingsItem key="salesOrganization" text="{i18n>list.col.salesOrg}"/>
			<ViewSettingsItem key="magentoCompany" text="{i18n>list.col.magentoCompany}"/>
			<ViewSettingsItem key="orderVolume" text="{i18n>list.col.orderVolume}"/>
		</sortItems>
	</ViewSettingsDialog>
</core:FragmentDefinition>

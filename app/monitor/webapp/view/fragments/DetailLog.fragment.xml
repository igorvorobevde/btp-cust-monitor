<core:FragmentDefinition
	xmlns:core="sap.ui.core"
	xmlns="sap.m">
	<Table
		id="logTable"
		growing="true"
		growingThreshold="20"
		noDataText="{i18n>detail.log.noData}"
		items="{
			path: 'log',
			parameters: {$orderby: 'line desc'},
			templateShareable: false
		}">
		<columns>
			<Column width="3rem" hAlign="Center">
				<Text text="{i18n>detail.log.col.type}"/>
			</Column>
			<Column minScreenWidth="Tablet" demandPopin="true" width="11rem">
				<Text text="{i18n>detail.log.col.time}"/>
			</Column>
			<Column minScreenWidth="Tablet" demandPopin="true" width="9rem">
				<Text text="{i18n>detail.log.col.user}"/>
			</Column>
			<Column minScreenWidth="Tablet" demandPopin="true" width="7rem">
				<Text text="{i18n>detail.log.col.step}"/>
			</Column>
			<Column>
				<Text text="{i18n>detail.log.col.message}"/>
			</Column>
			<Column minScreenWidth="Desktop" demandPopin="true">
				<Text text="{i18n>detail.log.col.field}"/>
			</Column>
			<Column minScreenWidth="Desktop" demandPopin="true">
				<Text text="{i18n>detail.log.col.oldValue}"/>
			</Column>
			<Column minScreenWidth="Desktop" demandPopin="true">
				<Text text="{i18n>detail.log.col.newValue}"/>
			</Column>
		</columns>
		<items>
			<ColumnListItem>
				<cells>
					<core:Icon
						src="{path: 'messageType', formatter: '.formatter.logTypeIcon'}"
						color="{path: 'messageType', formatter: '.formatter.logTypeColor'}"
						tooltip="{messageType}"/>
					<Text text="{createdAt}"/>
					<Text text="{createdBy}"/>
					<Text text="{step}"/>
					<Text text="{messageText}"/>
					<Text text="{fieldName}"/>
					<Text text="{oldValue}"/>
					<Text text="{newValue}"/>
				</cells>
			</ColumnListItem>
		</items>
	</Table>
</core:FragmentDefinition>

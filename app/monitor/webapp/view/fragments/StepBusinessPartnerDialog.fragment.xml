<core:FragmentDefinition
	xmlns:core="sap.ui.core"
	xmlns="sap.m">
	<Dialog
		id="stepBpDialog"
		title="{view>/stepDialog/title}"
		type="Message"
		contentWidth="24rem"
		afterClose=".onStepDialogAfterClose">
		<content>
			<Label text="{i18n>step.dialog.bp.label}" labelFor="stepBpInput" required="true"/>
			<Input
				id="stepBpInput"
				value="{view>/stepDialog/businessPartner}"
				maxLength="10"
				valueLiveUpdate="true"
				placeholder="{i18n>step.dialog.bp.placeholder}"
				valueState="{view>/stepDialog/valueState}"
				valueStateText="{i18n>step.dialog.bp.digitsOnly}"
				required="true"
				liveChange=".onStepInputChange"
				submit=".onStepDialogConfirm"/>
		</content>
		<beginButton>
			<Button
				id="stepBpOk"
				text="{i18n>common.ok}"
				type="Emphasized"
				enabled="{view>/stepDialog/valid}"
				press=".onStepDialogConfirm"/>
		</beginButton>
		<endButton>
			<Button id="stepBpCancel" text="{i18n>common.cancel}" press=".onStepDialogCancel"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>

{
	"_version": "2.0.0",
	"sap.app": {
		"id": "hydac.custmon",
		"type": "application",
		"i18n": {
			"bundleName": "hydac.custmon.i18n.i18n",
			"supportedLocales": [
				"",
				"de"
			],
			"fallbackLocale": ""
		},
		"title": "{{appTitle}}",
		"description": "{{appDescription}}",
		"applicationVersion": {
			"version": "0.2.0"
		},
		"dataSources": {
			"mainService": {
				"uri": "/odata/v4/monitor/",
				"type": "OData",
				"settings": {
					"odataVersion": "4.0"
				}
			}
		},
		"crossNavigation": {
			"inbounds": {
				"Kundenmonitor-display": {
					"semanticObject": "Kundenmonitor",
					"action": "display",
					"title": "{{appTitle}}",
					"subTitle": "{{appDescription}}",
					"icon": "sap-icon://customer-briefing",
					"signature": {
						"parameters": {},
						"additionalParameters": "allowed"
					}
				}
			}
		}
	},
	"sap.ui": {
		"technology": "UI5",
		"deviceTypes": {
			"desktop": true,
			"tablet": true,
			"phone": false
		}
	},
	"sap.ui5": {
		"flexEnabled": true,
		"rootView": {
			"viewName": "sap.fe.templates.RootContainer.view.Fcl",
			"type": "XML",
			"id": "appRootView"
		},
		"dependencies": {
			"minUI5Version": "1.148.12",
			"libs": {
				"sap.ui.core": {},
				"sap.m": {},
				"sap.f": {},
				"sap.fe.templates": {}
			}
		},
		"contentDensities": {
			"compact": true,
			"cozy": true
		},
		"models": {
			"i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"settings": {
					"bundleName": "hydac.custmon.i18n.i18n",
					"supportedLocales": [
						"",
						"de"
					],
					"fallbackLocale": ""
				}
			},
			"": {
				"dataSource": "mainService",
				"preload": true,
				"settings": {
					"operationMode": "Server",
					"autoExpandSelect": true,
					"earlyRequests": true
				}
			}
		},
		"resources": {
			"css": [
				{
					"uri": "css/style.css"
				}
			]
		},
		"routing": {
			"config": {
				"routerClass": "sap.f.routing.Router",
				"controlId": "appContent",
				"controlAggregation": "beginColumnPages",
				"flexibleColumnLayout": {
					"defaultTwoColumnLayoutType": "TwoColumnsMidExpanded"
				}
			},
			"routes": [
				{
					"name": "RequestsList",
					"pattern": ":?query:",
					"target": [
						"RequestsList"
					]
				},
				{
					"name": "RequestsObjectPage",
					"pattern": "Requests({key}):?query:",
					"target": [
						"RequestsList",
						"RequestsObjectPage"
					]
				}
			],
			"targets": {
				"RequestsList": {
					"type": "Component",
					"id": "RequestsList",
					"name": "sap.fe.templates.ListReport",
					"controlAggregation": "beginColumnPages",
					"options": {
						"settings": {
							"contextPath": "/Requests",
							"enhanceI18n": ["i18n"],
							"initialLoad": "Enabled",
							"variantManagement": "None",
							"views": {
								"paths": [
									{
										"key": "MyWork",
										"annotationPath": "com.sap.vocabularies.UI.v1.SelectionVariant#MyWork"
									},
									{
										"key": "Error",
										"annotationPath": "com.sap.vocabularies.UI.v1.SelectionVariant#Error"
									},
									{
										"key": "Clarification",
										"annotationPath": "com.sap.vocabularies.UI.v1.SelectionVariant#Clarification"
									},
									{
										"key": "Release",
										"annotationPath": "com.sap.vocabularies.UI.v1.SelectionVariant#Release"
									},
									{
										"key": "All",
										"annotationPath": "com.sap.vocabularies.UI.v1.SelectionVariant#All"
									}
								],
								"showCounts": true
							},
							"navigation": {
								"Requests": {
									"detail": {
										"route": "RequestsObjectPage"
									}
								}
							},
							"controlConfiguration": {
								"@com.sap.vocabularies.UI.v1.LineItem": {
									"tableSettings": {
										"type": "ResponsiveTable",
										"selectionMode": "None",
										"personalization": {
											"column": true,
											"sort": true,
											"filter": false,
											"group": false
										},
										"popinLayout": "GridSmall"
									},
									"columns": {
										"DataField::status_code": {
											"width": "12rem"
										},
										"DataField::releaseReason": {
											"width": "11rem"
										},
										"DataField::processType": {
											"width": "10rem"
										},
										"DataFieldForAnnotation::FieldGroup::Name": {
											"width": "15rem"
										},
										"DataField::nextStepText": {
											"width": "13rem"
										},
										"DataField::waitingText": {
											"width": "7rem"
										},
										"DataField::customer": {
											"width": "7rem"
										},
										"DataField::salesOrganization": {
											"width": "6rem"
										},
										"DataField::magentoCompany": {
											"width": "8rem"
										},
										"DataField::orderVolume": {
											"width": "8rem"
										},
										"DataFieldForAnnotation::FieldGroup::Created": {
											"width": "10rem"
										},
										"DataFieldForAnnotation::FieldGroup::Changed": {
											"width": "10rem"
										},
										"HintsColumn": {
											"key": "HintsColumn",
											"header": "{i18n>list.col.hints}",
											"template": "hydac.custmon.ext.fragment.HintsColumn",
											"availability": "Default",
											"importance": "High",
											"width": "5.5rem",
											"horizontalAlign": "Begin",
											"properties": [
												"released",
												"inClarification",
												"orderExists"
											],
											"position": {
												"placement": "After",
												"anchor": "DataField::status_code"
											}
										}
									}
								}
							}
						}
					}
				},
				"RequestsObjectPage": {
					"type": "Component",
					"id": "RequestsObjectPage",
					"name": "sap.fe.templates.ObjectPage",
					"controlAggregation": "midColumnPages",
					"options": {
						"settings": {
							"contextPath": "/Requests",
							"enhanceI18n": ["i18n"],
							"editableHeaderContent": false,
							"showRelatedApps": false,
							"content": {
								"header": {
									"facets": {
										"ClarificationStrip": {
											"template": "hydac.custmon.ext.fragment.ClarificationStrip",
											"stashed": false,
											"position": {
												"placement": "Before",
												"anchor": "StatusPoint"
											}
										}
									},
									"actions": {
										"Refresh": {
											"press": ".extension.hydac.custmon.ext.controller.ObjectPageExt.onRefresh",
											"text": "{i18n>common.refresh}",
											"visible": true,
											"position": {
												"placement": "After",
												"anchor": "DataFieldForActionGroup::Steps"
											}
										}
									}
								}
							},
							"controlConfiguration": {
								"log/@com.sap.vocabularies.UI.v1.LineItem": {
									"tableSettings": {
										"type": "ResponsiveTable",
										"selectionMode": "None",
										"personalization": false
									}
								}
							}
						}
					}
				}
			}
		},
		"extends": {
			"extensions": {
				"sap.ui.controllerExtensions": {
					"sap.fe.templates.ObjectPage.ObjectPageController": {
						"controllerName": "hydac.custmon.ext.controller.ObjectPageExt"
					}
				}
			}
		}
	},
	"sap.fiori": {
		"registrationIds": [],
		"archeType": "transactional"
	},
	"sap.cloud": {
		"public": true,
		"service": "kundenmonitorbtp.service"
	}
}

    "@ui5/cli": "4.0.71",
    "@ui5/linter": "1.23.7",
    "eslint": "9.39.5",
    "globals": "17.13.0",
    "ui5-test-runner": "5.14.2"
  },
  "scripts": {
    "lint": "npm run lint:ui5 && npm run lint:js",

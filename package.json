{
  "name": "kundenmonitor-btp",
  "version": "0.1.0",
  "description": "Kundenmonitor BTP – Rebuild of ZEC_CUSTOMER_MONITOR (CAP + Fiori Elements V4)",
  "private": true,
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "app/*"
  ],
  "dependencies": {
    "@cap-js/hana": "2.8.3",
    "@sap/cds": "9.9.3",
    "@sap/xssec": "4.15.0"
  },
  "devDependencies": {
    "@cap-js/cds-test": "1.0.2",
    "@cap-js/sqlite": "2.4.3",
    "@sap/cds-dk": "9.9.7",
    "@sap/eslint-plugin-cds": "4.2.5",
    "cds-plugin-ui5": "0.17.4",
    "eslint": "9.39.5",
    "jest": "30.5.2"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "lint": "npm run lint:cds && npm run lint --workspace app/monitor",
    "lint:cds": "cds lint",
    "lint:ui5": "npm run lint:ui5 --workspace app/monitor",
    "lint:js": "npm run lint:js --workspace app/monitor",
    "test": "npm run test:srv && npm run test:opa",
    "test:srv": "jest --runInBand",
    "test:opa": "npm run test:opa --workspace app/monitor",
    "start:test": "cds-serve --profile opa --port 4004",
    "build": "cds build --production"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/test/**/*.test.js"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/gen/"
    ],
    "testTimeout": 20000
  },
  "cds": {
    "fiori": {
      "draft_lock_timeout": "15min",
      "draft_deletion_timeout": "7d",
      "draft_messages": false
    },
    "requires": {
      "[development]": {
        "auth": {
          "kind": "mocked",
          "users": {
            "alice": {
              "password": "alice",
              "roles": [
                "MonitorViewer",
                "MonitorEditor",
                "MonitorReleaser"
              ],
              "attr": {
                "SalesOrg": [
                  "0001",
                  "2000",
                  "7050"
                ]
              }
            },
            "bob": {
              "password": "bob",
              "roles": [
                "MonitorViewer"
              ],
              "attr": {
                "SalesOrg": [
                  "0001"
                ]
              }
            },
            "carol": {
              "password": "carol",
              "roles": [
                "MonitorViewer",
                "MonitorEditor"
              ],
              "attr": {
                "SalesOrg": [
                  "0001",
                  "2000",
                  "7050"
                ]
              }
            }
          }
        }
      },
      "[opa]": {
        "auth": {
          "kind": "dummy"
        }
      },
      "[production]": {
        "db": "hana",
        "auth": "xsuaa"
      },
      "destinations": true,
      "html5-repo": true,
      "workzone": true
    }
  }
}
